load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

java_library(
    name = "decision_audit",
    srcs = ["src/DecisionAudit.java"],
)

java_test(
    name = "decision_audit_test",
    srcs = ["src/DecisionAuditTest.java"],
    test_class = "com.example.entitlement.DecisionAuditTest",
    deps = [":decision_audit"],
)

java_library(
    name = "entitlement",
    srcs = ["src/PlanEntitlement.java"],
)

java_library(
    name = "feature_override",
    srcs = ["src/FeatureOverride.java"],
    deps = [":entitlement"],
)

java_library(
    name = "expired_entitlement_deny",
    srcs = ["src/ExpiredEntitlementDeny.java"],
    deps = [":entitlement"],
)

java_test(
    name = "entitlement_test",
    srcs = ["src/PlanEntitlementTest.java"],
    test_class = "com.example.entitlement.PlanEntitlementTest",
    deps = [":entitlement"],
)

java_test(
    name = "feature_override_test",
    srcs = ["src/FeatureOverrideTest.java"],
    test_class = "com.example.entitlement.FeatureOverrideTest",
    deps = [":feature_override", ":entitlement"],
)

java_test(
    name = "expired_entitlement_deny_test",
    srcs = ["src/ExpiredEntitlementDenyTest.java"],
    test_class = "com.example.entitlement.ExpiredEntitlementDenyTest",
    deps = [":expired_entitlement_deny", ":entitlement"],
)

sh_test(
    name = "bootstrap_check",
    srcs = ["scripts/bootstrap_check.sh"],
    data = [
        "evidence/plan-entitlement/feature.json",
        "evidence/feature-override/feature.json",
        "evidence/decision-audit/feature.json",
        "evidence/expired-entitlement-denial/feature.json",
        "gsd/features.json",
        "provenance/plan-entitlement/provenance.json",
        "provenance/feature-override/provenance.json",
        "provenance/decision-audit/provenance.json",
        "provenance/expired-entitlement-denial/provenance.json",
        "trace/plan-entitlement/trace.json",
        "trace/feature-override/trace.json",
        "trace/decision-audit/trace.json",
        "trace/expired-entitlement-denial/trace.json",
    ],
)
